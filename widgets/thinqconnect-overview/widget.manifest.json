{
  "id": "io.piphi.thinqconnect.overview",
  "name": "LG ThinQ Overview",
  "description": "See the readings your selected LG appliance supports.",
  "version": "0.1.7",
  "entry": "./dist/widget.js",
  "binding_modes": [
    "read"
  ],
  "value_kinds": [
    "boolean",
    "numeric",
    "text"
  ],
  "capability_requirements": [
    "appliance_state",
    "mode",
    "remaining_minutes",
    "cycle_count",
    "door",
    "temperature",
    "target_temperature",
    "humidity",
    "pm2",
    "fan_speed",
    "power",
    "battery",
    "filter_life"
  ],
  "interaction_targets": [
    {
      "id": "appliance-details",
      "label": "LG appliance details",
      "kind": "card",
      "allowed_actions": [
        "more-info"
      ],
      "default_action": "more-info"
    }
  ],
  "sdk_compatibility": {
    "minimum": "0.4.0"
  },
  "conformance": {
    "accessibility": "wcag2.2-aa",
    "keyboard": true,
    "themes": [
      "light",
      "dark"
    ],
    "directions": [
      "ltr",
      "rtl"
    ],
    "states": [
      "loading",
      "empty",
      "live",
      "stale",
      "offline",
      "reconnecting",
      "denied",
      "error"
    ]
  },
  "settings_schema_version": "1",
  "settings": [
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "default": "LG appliance"
    },
    {
      "id": "device",
      "type": "device",
      "label": "Device",
      "required": true
    }
  ],
  "layout": {
    "transparent": true,
    "min_height": 144,
    "default_height": 160,
    "max_height": 196
  },
  "previews": {
    "light": "./previews/light.svg",
    "dark": "./previews/dark.svg"
  },
  "translations": {
    "en": {
      "widget.title": "LG appliance",
      "widget.waiting": "Waiting for LG ThinQ data"
    },
    "es": {
      "widget.title": "Resumen de LG ThinQ",
      "widget.waiting": "Esperando datos de LG ThinQ"
    },
    "ar": {
      "widget.title": "نظرة عامة على LG ThinQ",
      "widget.waiting": "في انتظار بيانات LG ThinQ"
    }
  },
  "security": {
    "permissions": [],
    "allowed_commands": [],
    "sandbox": [
      "allow-scripts"
    ],
    "csp": {
      "connect_src": []
    }
  },
  "integrity": "sha256-6NAqPVwJ2hBmx7CP76Wm3paNhqsTD+MhSVIhkyPk99I="
}
